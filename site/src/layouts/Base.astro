---
import '@fontsource-variable/manrope';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F5F2EB">
  <meta name="color-scheme" content="light">
  <meta name="description" content="O Forseti é a camada de reconciliação e coordenação entre os sistemas que a cadeia logística já usa: compara as versões do mesmo compromisso e mostra quem precisa agir. Equipe The Foundry, HackBrasil 2026.">
  <meta property="og:title" content="Forseti · camada de reconciliação e coordenação">
  <meta property="og:description" content="Diferentes versões da operação. Uma resolução compartilhada. O Forseti compara os documentos de cada empresa e mostra quem precisa agir. Em construção no HackBrasil 2026.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://the-foundry-alpha.vercel.app/">
  <meta property="og:image" content="https://the-foundry-alpha.vercel.app/assets/og.png">
  <meta property="og:locale" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://the-foundry-alpha.vercel.app/assets/og.png">
  <title>Forseti · camada de reconciliação e coordenação · HackBrasil 2026</title>
  <link rel="icon" type="image/svg+xml" href="./favicon.svg">
  <link rel="icon" type="image/x-icon" href="./favicon.ico">
  <script is:inline>
    (function (d) {
      var c = d.classList;
      c.replace('no-js', 'js');
      // Single source of truth for reduced motion: CSS, motion.ts and the stickers read .reduce.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches ||
          new URLSearchParams(location.search).get('reduce') === '1') c.add('reduce');
      // If motion.ts never boots, nothing may stay hidden behind .rv.
      setTimeout(function () { if (!c.contains('motion-ok')) c.add('rv-safe'); }, 2500);
    })(document.documentElement);
  </script>
</head>
<body>
  <a class="skip" href="#hero">Pular para o conteúdo</a>
  <div class="progress" aria-hidden="true"><span id="progress"></span></div>
  <div class="backdrop" aria-hidden="true"></div>

  <header class="top">
    <a class="brand" href="#topo" aria-label="Forseti, voltar ao topo">
      <img class="lockup" src="./assets/forseti-lockup-petroleo.svg" alt="Forseti" width="132" height="55">
    </a>
    <nav aria-label="Seções">
      <a href="#pitch">Pitch</a>
      <a href="#materia">Problema</a>
      <a href="#forma">Solução</a>
      <a href="#fogo">Campo</a>
      <a href="#progresso">Progresso</a>
      <a href="#forja">Time</a>
    </nav>
    <p class="top-status"><span class="pulse" aria-hidden="true"></span>Build in public</p>
  </header>

  <slot />

  <footer class="foot">
    <!-- A bigorna fica só como crédito da equipe; a marca do produto é o lockup v4. -->
    <svg class="mark" viewBox="140 318 212 140" aria-hidden="true">
      <path d="M144 323.3H348.7V344.9C312 358 278.7 376 278.7 400C278.7 418 294 429 319.1 436.5V454H172.9V436.5C198 429 211.3 418 211.3 400C211.3 376 178 358 144 344.9Z"/>
    </svg>
    <span>O Forseti é desenvolvido pela equipe The Foundry · HackBrasil 2026</span>
    <span>Registro em andamento · <time datetime="2026-11-22">22 nov 2026</time></span>
    <a href="#topo">Voltar ao topo</a>
  </footer>

  <script>
    import '../scripts/motion.ts';
  </script>
</body>
</html>
