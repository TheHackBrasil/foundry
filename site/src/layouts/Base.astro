---
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0c0e">
  <meta name="description" content="The Foundry: três pessoas investigando em público por que empresas que trabalham juntas não enxergam a mesma operação. HackBrasil 2026, trilha Logística e Automação.">
  <meta property="og:title" content="The Foundry · Diário de construção">
  <meta property="og:description" content="Um pedido. Cinco sistemas. Nenhuma verdade. Investigação logística em público no HackBrasil 2026.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://thehackbrasil.github.io/foundry/">
  <meta property="og:image" content="https://thehackbrasil.github.io/foundry/assets/og.png">
  <meta property="og:locale" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://thehackbrasil.github.io/foundry/assets/og.png">
  <title>The Foundry · Diário de construção · HackBrasil 2026</title>
  <link rel="icon" type="image/svg+xml" href="./assets/foundry-mark.svg">
  <script is:inline>
    (function (d) {
      var c = d.classList;
      c.replace('no-js', 'js');
      // Single source of truth for reduced motion: CSS and motion.ts read .reduce.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches ||
          new URLSearchParams(location.search).get('reduce') === '1') c.add('reduce');
      // If motion.ts never boots, nothing may stay hidden behind .rv.
      setTimeout(function () { if (!c.contains('motion-ok')) c.add('rv-safe'); }, 2500);
    })(document.documentElement);
  </script>
</head>
<body>
  <div class="progress" aria-hidden="true"><span id="progress"></span></div>
  <div class="backdrop" aria-hidden="true"></div>
  <canvas class="forge" id="forge" aria-hidden="true"></canvas>
  <aside class="thermo mono" aria-hidden="true">
    <div class="thermo-scale">
      <span style="--v:1">1200</span><span style="--v:0.6667">800</span><span style="--v:0.3333">400</span><span style="--v:0.0208">25</span>
      <i class="thermo-fill"></i>
      <i class="thermo-track"><i class="thermo-needle"></i></i>
    </div>
    <div class="thermo-read">
      <span class="thermo-chap">CAP.01</span>
      <b class="thermo-val">25°C</b>
      <span class="thermo-name">MATÉRIA-PRIMA</span>
    </div>
  </aside>

  <header class="top">
    <a class="brand" href="#topo" aria-label="The Foundry, voltar ao topo">
      <svg class="anvil" viewBox="0 0 48 32" aria-hidden="true"><path d="M4 6h26l6 5-6 5h-8l4 4-2 6H10l-2-6 4-4H4V6z" fill="currentColor"/></svg>
      <span>THE<br>FOUNDRY</span>
    </a>
    <nav aria-label="Seções">
      <a href="#materia">A dor</a>
      <a href="#fogo">Campo</a>
      <a href="#forma">Decisão</a>
      <a href="#tempera">Aberto</a>
      <a href="#forja">Time</a>
    </nav>
    <div class="top-status"><span class="pulse" aria-hidden="true"></span>BUILD IN PUBLIC</div>
  </header>

  <slot />

  <footer class="foot mono">
    <span>THE FOUNDRY · HACKBRASIL 2026</span>
    <span>REGISTRO EM ANDAMENTO · 19 NOV 2026</span>
    <a href="https://github.com/TheHackBrasil/foundry" target="_blank" rel="noopener noreferrer">REPOSITÓRIO ↗</a>
  </footer>

  <script>
    import '../scripts/motion.ts';
  </script>
</body>
</html>
