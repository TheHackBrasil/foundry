---
import Base from '../layouts/Base.astro';
import Domino from '../components/domino/Domino';
import Parties from '../components/stickers/Parties';
import Progress from '../components/Progress.astro';
import Pitch from '../components/Pitch.astro';
import { DEMO_URL, VIDEO_URL, live } from '../config';

const demo = live(DEMO_URL);
const video = live(VIDEO_URL);

const ticker = [
  ['SERENA', 'O ENCONTRO NA NEWHACK'],
  ['05 NOV', 'LANÇAMENTO NA FIAP PAULISTA'],
  ['09 A 13 NOV', 'CAMPO NA FENATRAN'],
  ['16 NOV', 'DIREÇÃO ESCOLHIDA'],
  ['18 NOV', 'CONVERSA COM A ENVIAGORA REAGENDADA'],
  ['20 NOV', 'ESCOPO DO MVP FECHADO'],
  ['22 NOV', 'O PRODUTO SE CHAMA FORSETI'],
  ['22 NOV', 'IDENTIDADE V4 APROVADA'],
  ['30/11', 'PRIMEIRA ENTREGA'],
];
---

<Base>
  <main id="topo">

    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-copy">
        <h1 class="hero-title">
          <span class="ln"><span>Diferentes versões</span></span>
          <span class="ln"><span>da operação.</span></span>
          <span class="ln"><span>Uma <em>resolução</em></span></span>
          <span class="ln"><span><em>compartilhada.</em></span></span>
        </h1>
        <p class="hero-sub">O Forseti é a camada de <b>reconciliação e coordenação</b> entre
          os sistemas que a cadeia já usa: lê os documentos de cada empresa, compara as
          versões do mesmo compromisso e mostra onde divergem e quem precisa agir.</p>
        <p class="hero-verbs" aria-label="O que o Forseti faz"><b>lê</b><b>compara</b><b>mostra</b></p>
        <p class="hero-not"><b>Não somos</b> uma transportadora, um TMS, um ERP, um rastreador nem um chatbot.</p>
        <div class="hero-actions">
          <a class="btn" href="#pitch">Assistir ao pitch <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z"/></svg></a>
          <a class="btn ghost" href="#materia">Ver o problema <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3 8.5l5 5 5-5"/></svg></a>
        </div>
      </div>
      <dl class="hero-facts">
        <div><dt>HackBrasil 2026</dt><dd>Trilha Logística e Automação</dd></div>
        <div><dt>Para quem</dt><dd>Cadeias com vários fornecedores e operadores</dd></div>
        <div><dt>Estágio</dt><dd>MVP em construção</dd></div>
        <div><dt>Primeira entrega</dt><dd><time datetime="2026-11-30T23:59-03:00">30 nov 2026, 23h59</time></dd></div>
      </dl>
      <svg class="hero-scene cords" viewBox="0 0 620 560" aria-hidden="true" focusable="false">
        <g class="mono-g">
          <rect class="mono" x="296" y="60" width="88" height="440"/>
          <rect class="mono m2" x="412" y="150" width="96" height="350"/>
          <rect class="mono m3" x="532" y="236" width="76" height="264"/>
        </g>
        <path d="M0 96 C 160 84 380 116 620 100"/>
        <path d="M0 176 C 160 162 380 196 620 180"/>
        <path d="M0 256 C 160 240 380 276 620 260"/>
        <path d="M0 336 C 160 320 380 356 620 340"/>
        <circle class="cord-signal" cx="430" cy="187" r="7"/>
      </svg>
    </section>

    <Pitch />

    <!-- TICKER -->
    <div class="ticker" role="region" aria-label="Linha do tempo resumida" tabindex="0">
      <div class="ticker-track">
        <ul class="ticker-set">
          {ticker.map(([d, t]) => <li><b>{d}</b> {t}</li>)}
        </ul>
        <ul class="ticker-set" aria-hidden="true">
          {ticker.map(([d, t]) => <li><b>{d}</b> {t}</li>)}
        </ul>
      </div>
    </div>

    <!-- A DOR -->
    <section class="chapter" id="materia">
      <div class="split">
        <div class="copy rv">
          <h2>Hoje, cada empresa descobre o atraso <em>sozinha.</em></h2>
          <p>Uma operação real atravessa fornecedor, transportadora, centro de
            distribuição, fiscal e financeiro. Cada empresa registra no próprio
            sistema só aquilo que consegue ver.</p>
          <p>Quando algo muda, a informação viaja por telefone, planilha e
            conferência manual. Foi o que ouvimos na FENATRAN e nas conversas
            com quem opera isso todos os dias.</p>
          <p class="hint">Na simulação, arraste o atraso e compare o que cada sistema mostra.</p>
        </div>
        <div class="bench rv" id="domino-slot">
          <Domino client:visible />
        </div>
      </div>
    </section>

    <!-- DECISÃO -->
    <section class="chapter" id="forma">
      <div class="split">
        <div class="copy rv">
          <h2>Uma camada sobre os sistemas que <em>já existem.</em></h2>
          <p class="lead">Ninguém troca de ERP nem muda de rotina. O Forseti lê os
            documentos que cada parceiro já produz, mantém um registro único do pedido
            e mostra onde as versões divergem.</p>
          <ol class="steps">
            <li><b>Lê</b><span>NF-e e CT-e em XML, planilha em CSV e e-mail com o documento em anexo.</span></li>
            <li><b>Compara</b><span>Confere as fontes campo a campo e aponta cada divergência com origem e versão.</span></li>
            <li><b>Mostra</b><span>O que mudou, por quê e a tarefa sugerida para cada papel: fornecedor, transportadora, CD, fiscal e financeiro.</span></li>
          </ol>
          <p>O Forseti mostra o que mudou, por quê e quem precisa agir, e a decisão fica
            com cada empresa. Não é transportadora, TMS, ERP, rastreador nem chatbot.</p>
        </div>
        <dl class="ledger rv" aria-label="O que já decidimos">
          <div class="ledger-head"><dt>Decidido em 16/11</dt><dd></dd></div>
          <div><dt>Dentro</dt><dd>Camada de coordenação: alertas, registro compartilhado, divergências.</dd></div>
          <div class="out"><dt>Fora</dt><dd>Roteirização interna: mercado saturado, exige hardware na PME.</dd></div>
          <div><dt>Opção</dt><dd>Blockchain como registro entre desconhecidos: entra só se fizer falta.</dd></div>
          <div><dt>Dado</dt><dd>Capacidade ociosa (doca, retorno, estoque) viaja na mesma camada.</dd></div>
        </dl>
      </div>
      <div class="layer rv">
        <Parties client:visible />
        <!-- A camada: as quatro cordas ligam os quatro papéis numa resolução só. -->
        <svg class="layer-cords cords" viewBox="0 0 1160 120" aria-hidden="true" focusable="false">
          <path d="M0 16 C 290 8 870 26 1160 14"/>
          <path d="M0 46 C 290 38 870 56 1160 44"/>
          <path d="M0 76 C 290 68 870 86 1160 74"/>
          <path d="M0 106 C 290 98 870 116 1160 104"/>
          <circle class="cord-signal" cx="560" cy="50" r="6"/>
        </svg>
      </div>
    </section>

    <!-- CAMPO -->
    <section class="chapter" id="fogo">
      <div class="copy intro rv">
        <h2>O que ouvimos antes de <em>decidir.</em></h2>
        <p>Fomos a campo antes de escolher o produto. Cada etapa abaixo está
          registrada com data no repositório.</p>
      </div>

      <ol class="spine">
        <li class="stop">
          <p class="stop-date"><b>NOV</b><span>Serena</span></p>
          <div class="stop-media rv"><div class="drift">
            <figure class="print tilt-r">
              <img src="./assets/serena.webp" alt="Fachada do Serena, sede do encontro da comunidade NewHack" loading="lazy">
              <figcaption>Serena, São Paulo</figcaption>
            </figure>
          </div></div>
          <div class="stop-copy rv">
            <h3>O encontro</h3>
            <p>Três caminhos se cruzaram num encontro da NewHack. Saímos de lá com um
              combinado: construir algo juntos.</p>
          </div>
        </li>

        <li class="stop">
          <p class="stop-date"><time datetime="2026-11-05"><b>05</b><span>nov · FIAP</span></time></p>
          <div class="stop-media rv"><div class="drift">
            <div class="hack-card">
              <canvas class="ascii-map" aria-hidden="true"></canvas>
              <p class="hack-word" aria-hidden="true">HACK<br>BRASIL</p>
            </div>
            <figure class="print tilt-l overlap">
              <img src="./assets/fiap.webp" alt="Registro do lançamento presencial do HackBrasil na FIAP Paulista" loading="lazy">
              <figcaption>FIAP Paulista</figcaption>
            </figure>
          </div></div>
          <div class="stop-copy rv">
            <h3>O desafio</h3>
            <p>Lançamento presencial do HackBrasil 2026. Escolhemos a trilha de
              Logística e Automação: um setor onde problema não falta.</p>
            <p><a class="more" href="https://hackbrasil.com/" target="_blank" rel="noopener noreferrer">Conhecer o HackBrasil</a></p>
          </div>
        </li>

        <li class="stop">
          <p class="stop-date"><time datetime="2026-11-09"><b>09</b><span>a 13 nov</span></time></p>
          <div class="stop-media rv"><div class="drift">
            <div class="pair">
              <figure class="print tilt-l">
                <img src="./assets/fenatran-pavilhao.webp" alt="Pavilhão da FENATRAN com caminhões e público" loading="lazy">
              </figure>
              <figure class="print tilt-r">
                <img src="./assets/fenatran-entrada.webp" alt="Entrada da FENATRAN" loading="lazy">
              </figure>
              <span class="tag">FENATRAN · São Paulo Expo</span>
            </div>
          </div></div>
          <div class="stop-copy rv">
            <h3>O campo</h3>
            <p>Conversamos com operadores, transportadoras e fábricas. A mesma dor
              voltou em formas diferentes: ninguém enxerga a mesma operação.</p>
          </div>
        </li>

        <li class="stop">
          <p class="stop-date"><b>NOV</b><span>LinkedIn</span></p>
          <div class="stop-media rv"><div class="drift">
            <div class="chain">
              <a class="person-row" href="https://www.linkedin.com/in/isabela-claro-sanches-96857b12/" target="_blank" rel="noopener noreferrer">
                <span class="avatar"><img src="./assets/isabela.webp" alt="Isabela Claro Sanches" loading="lazy"></span>
                <span><small>Primeira resposta</small><b>Isabela Claro Sanches</b></span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
              </a>
              <span class="chain-link" aria-hidden="true">indicou</span>
              <a class="person-row" href="https://www.linkedin.com/in/vivianne-moreira-leite/" target="_blank" rel="noopener noreferrer">
                <span class="avatar"><img src="./assets/vivianne.webp" alt="Vivianne Moreira Leite" loading="lazy"></span>
                <span><small>Especialista em armazéns</small><b>Vivianne Moreira Leite</b></span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
              </a>
              <span class="chain-link" aria-hidden="true">mesmo caminho</span>
              <a class="person-row" href="https://www.linkedin.com/in/rafael-alberto-born-03886bba/" target="_blank" rel="noopener noreferrer">
                <span class="avatar"><img src="./assets/rafael.webp" alt="Rafael Alberto Born, CEO da Enviagora" loading="lazy"></span>
                <span><small>CEO da Enviagora</small><b>Rafael Alberto Born</b></span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
              </a>
            </div>
          </div></div>
          <div class="stop-copy rv">
            <h3>Os contatos</h3>
            <p>Isabela respondeu primeiro e indicou Vivianne, especialista em
              armazéns. A conversa com Rafael, CEO da Enviagora, veio pelo mesmo
              caminho.</p>
            <p class="fine">Retratos identificam contatos reais. Não são depoimentos nem endosso.</p>
          </div>
        </li>

        <li class="stop">
          <p class="stop-date"><time datetime="2026-11-16"><b>16</b><span>nov · 1h43</span></time></p>
          <div class="stop-media rv"><div class="drift">
            <div class="call">
              <p class="call-head"><span>Alinhamento do time</span><span>1h43</span></p>
              <p class="call-title">Direção escolhida</p>
              <span class="wave" aria-hidden="true">{Array.from({ length: 40 }, (_, i) => <i style={`--i:${i}`} class={i === 16 ? 'mark' : undefined}></i>)}</span>
              <p class="call-foot"><span>0:00</span><span class="hot">~41 min: a decisão</span><span>1:43</span></p>
            </div>
          </div></div>
          <div class="stop-copy rv">
            <h3>A decisão</h3>
            <p>Depois de descartar a roteirização interna, o time bateu o martelo na
              camada de coordenação entre parceiros. Registrado na transcrição.</p>
          </div>
        </li>

        <li class="stop">
          <p class="stop-date warn"><time datetime="2026-11-18"><b>18</b><span>nov · Enviagora</span></time></p>
          <div class="stop-media rv"><div class="drift">
            <div class="call pending">
              <p class="call-head"><span>Rafael Born, CEO da Enviagora</span><span>Enviagora</span></p>
              <p class="call-title">Próxima conversa</p>
              <p class="call-sub">Um caso real para validar o produto.</p>
              <span class="stamp" aria-hidden="true">Reagendada</span>
            </div>
          </div></div>
          <div class="stop-copy rv">
            <h3>A próxima validação</h3>
            <p>A conversa com Rafael Born, CEO da Enviagora, foi reagendada. Em 20/11,
              escolhemos o fluxo do MVP sem esperar por ela, e a conversa passa a servir
              para validar o produto com um caso real.</p>
          </div>
        </li>
        <li class="stop">
          <p class="stop-date"><time datetime="2026-11-19"><b>19</b><span>nov · repositório</span></time></p>
          <div class="stop-media rv"><div class="drift">
            <figure class="repo-shot">
              <pre aria-hidden="true"><span>docs/</span>
  escopo.md
  fontes-e-contatos.md
  resumo-call-2026-11-16.md
<span>specs/</span>
  0001-publicacao-docs-pesquisa
  0002-site-foundry
<span>BACKLOG.md</span>
<span>DECISIONS.md</span></pre>
              <figcaption>github.com/TheHackBrasil/foundry</figcaption>
            </figure>
          </div></div>
          <div class="stop-copy rv">
            <h3>Começamos a construir</h3>
            <p>A pesquisa virou base de documentação no repositório, e o escopo do
              MVP saiu dela no dia seguinte. Cada decisão fica registrada com data
              em <code>DECISIONS.md</code>.</p>
            <p><a class="more" href="#progresso">Ver o progresso</a></p>
          </div>
        </li>
      </ol>
    </section>

    <!-- CÓDIGO -->
    <section class="chapter" id="tempera">
      <div class="copy intro rv">
        <h2>O que já está no <em>código.</em></h2>
        <p>Estado em 22/11, conferível na branch <code>main</code>. Os dados usados
          na demonstração são sintéticos.</p>
        <p><a class="more" href="https://github.com/TheHackBrasil/foundry/tree/main/app" target="_blank" rel="noopener noreferrer">Ver o código do Forseti</a></p>
      </div>
      <ul class="questions">
        <li class="q rv"><i class="heat" aria-hidden="true"></i><h3>Leitura dos documentos</h3><p>NF-e e CT-e em XML, planilha em CSV e e-mail (.eml) com o documento em anexo entram pelo mesmo caminho. O atraso chega pela planilha do fornecedor.</p></li>
        <li class="q rv"><i class="heat" aria-hidden="true"></i><h3>Comparação campo a campo</h3><p>Cada documento vira um evento do pedido. Quando duas fontes discordam sobre previsão de entrega, peso, volumes ou status, a divergência aparece com a origem e a versão de cada valor.</p></li>
        <li class="q rv"><i class="heat" aria-hidden="true"></i><h3>Tarefa por papel</h3><p>Para cada divergência, uma tabela de regras define a tarefa de quem precisa agir: fornecedor, transportadora, CD, fiscal ou financeiro.</p></li>
        <li class="q rv"><i class="heat" aria-hidden="true"></i><h3>Histórico verificável</h3><p>O registro só aceita acréscimo: o banco recusa alteração e exclusão, e cada evento leva o hash do anterior. A âncora numa blockchain pública é opcional e já foi testada na Base Sepolia, rede de testes.</p></li>
      </ul>
    </section>

    <!-- PROGRESSO -->
    <section class="chapter" id="progresso">
      <div class="copy intro rv">
        <h2>A construção, <em>commit a commit.</em></h2>
        <p>Lido direto do repositório público: arquivos, histórico e o backlog do time.</p>
      </div>
      <Progress />
    </section>

    <!-- TIME -->
    <section class="chapter" id="forja">
      <div class="copy intro rv">
        <h2>Quem está <em>construindo.</em></h2>
      </div>
      <div class="team">
        <a class="member rv" href="https://www.linkedin.com/in/gabriel-sacilotto-819343365/" target="_blank" rel="noopener noreferrer">
          <span class="portrait"><img src="./assets/gabriel.webp" alt="Gabriel Sacilotto" loading="lazy"></span>
          <b>Gabriel Sacilotto</b><span class="role">Produto e pesquisa</span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
        </a>
        <a class="member rv" href="https://www.linkedin.com/in/guilherme-barreto-mendes/" target="_blank" rel="noopener noreferrer">
          <span class="portrait"><img src="./assets/guilherme.webp" alt="Guilherme Barreto Mendes" loading="lazy"></span>
          <b>Guilherme Barreto</b><span class="role">Engenharia e sistemas</span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
        </a>
        <a class="member rv" href="https://www.linkedin.com/in/thisux/" target="_blank" rel="noopener noreferrer">
          <span class="portrait"><img src="./assets/thiago.webp" alt="Thiago Araujo" loading="lazy"></span>
          <b>Thiago Araujo</b><span class="role">Experiência e design</span><svg class="ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
        </a>
      </div>
    </section>

    <!-- FECHO -->
    <section class="closing" id="fecho">
      <!-- A partitura fecha a página: as versões divergentes viram uma resolução só. -->
      <svg class="cords" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 18 C 360 8 1080 30 1440 16"/>
        <path d="M0 44 C 360 34 1080 56 1440 42"/>
        <path d="M0 70 C 360 60 1080 82 1440 68"/>
        <path d="M0 96 C 360 86 1080 108 1440 94"/>
      </svg>
      <div class="closing-in">
        <h2 class="rv">Até 30/11: o primeiro fluxo, <em>de ponta a ponta.</em></h2>
        <p class="rv">O fluxo escolhido é o atraso propagado. Quando a planilha do fornecedor
          traz uma data nova, o Forseti compara com o que os outros documentos do pedido
          dizem e mostra a cada papel o que mudou e o que cabe a ele. A entrega da fase
          online reúne repositório, demo pública e um vídeo de até 3 minutos do produto.</p>
        <dl class="next rv">
          <div><dt>Demo pública</dt><dd>{demo ? <a href={demo} target="_blank" rel="noopener noreferrer">Abrir a demo do Forseti</a> : 'Em preparação'}</dd></div>
          <div><dt>Vídeo do produto</dt><dd>{video ? <a href={video} target="_blank" rel="noopener noreferrer">Assistir ao vídeo</a> : 'Em preparação'}</dd></div>
          <div><dt>Todo o processo é público</dt><dd><a href="https://github.com/TheHackBrasil/foundry" target="_blank" rel="noopener noreferrer">github.com/TheHackBrasil/foundry</a></dd></div>
        </dl>
      </div>
    </section>

  </main>
</Base>
