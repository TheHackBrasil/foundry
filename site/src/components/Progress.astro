---
// The public repo as GitHub shows it, rebuilt from the API: Code (file table),
// Commits and Projects (BACKLOG.md as a board). Snapshot at build, refreshed
// in the browser; tabs are buttons, and without JS every panel shows.
import octicons from '@primer/octicons';
import { COLUMNS, REPO, card, columnLabel, commitRow, fetchState } from '../scripts/repo-state';

const state = await fetchState(true, import.meta.env.GITHUB_TOKEN).catch((e) => {
  console.warn('repo snapshot failed:', e.message);
  return null;
});
const icon = (name: string, size = 16) => octicons[name].toSVG({ width: size, height: size, 'aria-hidden': 'true' });
const gh = `https://github.com/${REPO}`;
const head = state?.commits[0];
const fmt = (n: number | undefined) => (n ?? 0).toLocaleString('pt-BR');
---

<div class="gh" data-gh>
  <div class="gh-chrome" aria-hidden="true">
    <span></span><span></span><span></span>
    <p>github.com/{REPO}</p>
  </div>

  <header class="gh-repo">
    <p class="gh-title">
      <Fragment set:html={icon('repo')} />
      <a href={`https://github.com/${REPO.split('/')[0]}`} target="_blank" rel="noopener noreferrer">{REPO.split('/')[0]}</a>
      <span class="gh-slash">/</span>
      <a href={gh} target="_blank" rel="noopener noreferrer"><b>{REPO.split('/')[1]}</b></a>
      <span class="gh-pill">Public</span>
    </p>
    <ul class="gh-counters">
      <li><Fragment set:html={icon('eye')} />Watch <span>{fmt(state?.meta.watchers)}</span></li>
      <li><Fragment set:html={icon('repo-forked')} />Fork <span>{fmt(state?.meta.forks)}</span></li>
      <li><Fragment set:html={icon('star')} />Star <span>{fmt(state?.meta.stars)}</span></li>
    </ul>
  </header>

  <nav class="gh-tabs" role="tablist" aria-label="Repositório">
    <button role="tab" id="tab-code" aria-controls="gh-code" aria-selected="true"><Fragment set:html={icon('code')} />Code</button>
    <button role="tab" id="tab-commits" aria-controls="gh-commits" aria-selected="false" tabindex="-1"><Fragment set:html={icon('history')} />Commits{state?.count && <span class="gh-count">{state.count}</span>}</button>
    <button role="tab" id="tab-projects" aria-controls="gh-projects" aria-selected="false" tabindex="-1"><Fragment set:html={icon('table')} />Projects<span class="gh-count">1</span></button>
    <a href={`${gh}/releases`} target="_blank" rel="noopener noreferrer"><Fragment set:html={icon('tag')} />Releases{state?.release && <span class="gh-count">1</span>}</a>
  </nav>

  <div class="gh-body">
    <div class="gh-main">
      <section class="gh-panel on" id="gh-code" role="tabpanel" aria-labelledby="tab-code">
        <div class="gh-bar">
          <span class="gh-btn"><Fragment set:html={icon('git-branch')} />main<Fragment set:html={icon('triangle-down')} /></span>
          <a class="gh-btn green" href={gh} target="_blank" rel="noopener noreferrer"><Fragment set:html={icon('code')} />Code</a>
        </div>
        <div class="gh-box">
          <div class="gh-head">
            {head?.avatar ? <img data-head-ava src={`${head.avatar}&s=40`} alt="" width="20" height="20" /> : <span class="gh-ava"></span>}
            <b data-head-login>{head?.login ?? 'thisux1'}</b>
            <span class="gh-hmsg" data-head-msg>{head && <Fragment set:html={`<b>${head.type}:</b> ${head.msg.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)}`} />}</span>
            <span class="gh-hmeta" data-head-meta>{head && <Fragment set:html={`<code>${head.sha}</code> · <time datetime="${head.date}">${head.when}</time>`} />}</span>
            <a class="gh-hcount" href={`${gh}/commits/main`} target="_blank" rel="noopener noreferrer"><Fragment set:html={icon('history')} />{state?.count ?? ''} commits</a>
          </div>
          <ul class="gh-files">
            {state?.files.map((f) => (
              <li>
                <a href={f.url} target="_blank" rel="noopener noreferrer" class={f.dir ? 'dir' : 'file'}>
                  <Fragment set:html={icon(f.dir ? 'file-directory-fill' : 'file')} />
                  <span class="gh-fname">{f.name}</span>
                  <span class="gh-fmsg">{f.msg}</span>
                  <span class="gh-fwhen">{f.when}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="gh-panel" id="gh-commits" role="tabpanel" aria-labelledby="tab-commits">
        <p class="gh-sub">Commits em <b>main</b></p>
        <ol class="gh-commits" data-commits set:html={state?.commits.map(commitRow).join('') ?? ''} />
        <a class="gh-more" href={`${gh}/commits/main`} target="_blank" rel="noopener noreferrer">Ver histórico completo no GitHub</a>
      </section>

      <section class="gh-panel" id="gh-projects" role="tabpanel" aria-labelledby="tab-projects">
        <p class="gh-sub"><Fragment set:html={icon('table')} /><b>Backlog</b> · lido de <code>BACKLOG.md</code></p>
        <div class="gh-board">
          {COLUMNS.map((col) => {
            const items = state?.stages.filter((s) => s.status === col) ?? [];
            return (
              <div class={`gh-col st-${col}`} data-col={col}>
                <p class="gh-colhead"><span class="gh-dot"></span>{columnLabel(col)}<span class="gh-colcount">{items.length}</span></p>
                <ol set:html={items.map(card).join('')} />
              </div>
            );
          })}
        </div>
      </section>
    </div>

    <aside class="gh-side">
      <div class="gh-about">
        <h3>About</h3>
        <p>{state?.meta.description || 'The Foundry, HackBrasil 2026.'}</p>
        <p class="gh-meter"><span><b data-done>{state?.done ?? 0}</b> de <span data-total>{state?.total ?? 0}</span> etapas feitas</span><i aria-hidden="true"><i data-bar style={`--v:${state ? state.done / Math.max(1, state.total) : 0}`}></i></i></p>
      </div>
      <div class="gh-rel">
        <h3>Releases {state?.release && <span class="gh-count">1</span>}</h3>
        {state?.release ? (
          <a href={state.release.url} target="_blank" rel="noopener noreferrer">
            <Fragment set:html={icon('tag', 16)} />
            <span><b>{state.release.name}</b> <span class="gh-latest">Latest</span><br /><small>{state.release.when}</small></span>
          </a>
        ) : (
          <p class="gh-muted">Nenhuma release publicada.</p>
        )}
      </div>
      <p class="gh-sync" data-sync>{state ? `Lido do GitHub em ${state.read}` : 'Sem conexão com o GitHub no build.'}</p>
    </aside>
  </div>
</div>

<figure class="pitch" data-pitch hidden={!state?.release?.video}>
  {state?.release?.video && <video controls preload="metadata" playsinline src={state.release.video}></video>}
</figure>
{state?.release && (
  <p class="pitch-cap">Pitch em vídeo · <a href={state.release.url} target="_blank" rel="noopener noreferrer">{state.release.name} no GitHub</a></p>
)}

<script>
  import { fetchState, renderState } from '../scripts/repo-state';
  const root = document.querySelector<HTMLElement>('[data-gh]');
  if (root) {
    root.classList.add('gh-js');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const pick = (t: HTMLButtonElement) =>
      tabs.forEach((b) => {
        const on = b === t;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        root.querySelector(`#${b.getAttribute('aria-controls')}`)?.classList.toggle('on', on);
      });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        next.focus();
        pick(next);
      });
    });
    fetchState()
      .then((s) => renderState(document.body, s))
      .catch(() => {});
  }
</script>
