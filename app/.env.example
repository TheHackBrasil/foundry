# Copie para app/.env (ignorado pelo git) e preencha. Nunca commite valores.
# O servidor lê este arquivo ao subir com `npm start` ou `npm run dev`, a partir da pasta app/.
# Para PORT, WORKSPACE_SEED, CORS_ORIGIN e LLM_MODEL, variável vazia não é o mesmo que
# variável ausente (o código só aplica o padrão quando ela não existe): comente a que não usar.

# Postgres do ledger, obrigatório (D-024). Com `docker compose up -d` em app/:
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry
PORT=3000

# Isolamento por sessão (regulamento 6.9): workspace da seed, compartilhado com todas as sessões
# e somente leitura pela API.
WORKSPACE_SEED=seed
# Origens do CORS separadas por vírgula, sem barra no fim. Comentada, nenhum cabeçalho CORS sai e
# só a mesma origem lê a API (o caso do deploy, em que o servidor também serve a web). "*" é recusado.
# CORS_ORIGIN=https://seu-dominio.com

# Cabeçalho com o IP real do visitante, posto pelo proxy da hospedagem (na Railway: x-real-ip).
# Comentada, vale o endereço do socket. Só preencha atrás de um proxy que sobrescreve o cabeçalho.
# CLIENT_IP_HEADER=x-real-ip

# Limites da demo pública. Os valores comentados abaixo são os padrões; descomente só para mudar.
# Bytes por arquivo (2 MB); acima disso, 413.
# MAX_UPLOAD_BYTES=2097152
# Linhas de planilha ou anexos de e-mail por envio; acima disso, 413.
# MAX_DOCS_PER_UPLOAD=50
# Documentos e eventos por sessão; acima disso, 429.
# MAX_DOCS_PER_WORKSPACE=100
# MAX_EVENTS_PER_WORKSPACE=2000
# Tamanho do banco (3 GB) a partir do qual a API só aceita leitura (507); 0 desliga.
# MAX_DB_BYTES=3221225472
# Por IP: envios e decisões de revisão por minuto; âncoras, PDFs e comandos em linguagem
# natural a cada 10 min (PDF e mandatos usam LLM com cota).
# RATE_LIMIT_WRITES_PER_MIN=20
# RATE_LIMIT_ANCHORS_PER_10MIN=3
# RATE_LIMIT_PDFS_PER_10MIN=5
# RATE_LIMIT_MANDATOS_PER_10MIN=10
# Visões geradas por LLM (view-spec) por IP a cada 10 min; sem LLM a rota não conta cota.
# RATE_LIMIT_VIEWSPEC_PER_10MIN=20
# Teto de pedidos que um comando em linguagem natural alcança; acima disso, 422 filtro_largo.
# MANDATOS_MAX_ALVOS=5

# Stream ao vivo (SSE). A Railway corta stream público em 15 min e com 5 min sem dados: o servidor
# manda heartbeat e recicla a conexão antes (por tempo e por bytes), e o navegador reconecta sozinho.
# SSE_HEARTBEAT_MS=20000
# SSE_MAX_CONNECTION_MS=600000
# SSE_MAX_BYTES=524288
# SSE_MAX_CLIENTS=500
# SSE_MAX_CLIENTS_PER_IP=20

# Pasta do build da web servido pelo Fastify. Comentada, app/web/dist.
# WEB_DIST_DIR=

# Caixa de e-mail de teste para a ingestão automática. Sem IMAP_HOST, IMAP_USER e
# IMAP_PASS a leitura fica desligada. Use só conta de teste e documentos sintéticos.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_MS=30000
# Sem IMAP_DESDE, só mensagens de hoje em diante (D-025).
# IMAP_DESDE=2026-11-21

# Extração de PDF por LLM, API compatível com OpenAI (URL completa do endpoint de chat),
# como https://openrouter.ai/api/v1/chat/completions ou, local,
# http://localhost:11434/v1/chat/completions (Ollama). Sem URL e chave, todo PDF vai
# para a fila de revisão. O texto do PDF sai da máquina: só documento sintético
# (regulamento HackBrasil 6.9).
LLM_API_URL=
LLM_API_KEY=
# Comentada, o código usa gpt-6.2-sol; gpt-6-luna é a opção barata para parsing em volume.
# LLM_MODEL=
# Timeout de cada chamada à LLM em ms (PDF, mandatos, sinais, view-spec, mapeamento).
# LLM_TIMEOUT_MS=15000

# Nvoip para avisar as partes (spec 0007, RF8), desligada por padrão: sem URL e chave
# nada sai para a rede e o aviso registra 'nao_entregue' com o motivo. Os contatos
# fictícios da seed nunca recebem tráfego real: use só destinos de teste.
NVOIP_API_URL=
NVOIP_API_KEY=
# Canal dos contatos criados por documento; whatsapp|sms|ligacao (email a Nvoip não entrega).
# NVOIP_CANAL_PADRAO=whatsapp
# NVOIP_TIMEOUT_MS=10000
# Com '1', a criação de tarefa na propagação tenta avisar a parte pela Nvoip;
# comentada, só o comando 'notificar' dispara aviso.
# NVOIP_NOTIFY_ON_TASK=

# Âncora na Base Sepolia (opcional; RPC público: https://sepolia.base.org). Sem os três,
# a âncora responde 503 e o ledger segue local.
BASE_SEPOLIA_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

# Limites do parser .xlsx (worker_threads). O zip é checado antes de inflar e o
# worker roda com resourceLimits: quem falha na checagem nunca infla.
# XLSX_MAX_PARTES=512
# XLSX_MAX_INFLADO_BYTES=67108864
# XLSX_MAX_RAZAO=100
# XLSX_TIMEOUT_MS=10000
# XLSX_WORKER_MEM_MB=256
# XLSX_REVISAO_MAX_CSV=200000

# Comprovante verificável (spec 0011): segredo do HMAC que assina os links
# /api/comprovante/*. Sem ele, um segredo efêmero por processo assina (links
# quebram no restart). Definir em produção para links sobreviverem a deploys.
# COMPROVANTE_SECRET=

# Cobranca de status por e-mail (spec 0010): sem SMTP_HOST/SMTP_FROM a fila
# funciona mas o envio marca pendente_envio. Message-Id sai em SMTP_DOMAIN
# (default: SMTP_HOST). O destinatario vem so da agenda de contatos.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_DOMAIN=
# SMTP_TIMEOUT_MS=15000
# Janela minima entre envios do mesmo pedido (horas, default 24):
# COBRANCA_INTERVALO_HORAS=24
# Espera por resposta antes de expirar a cobranca (horas, default 72):
# COBRANCA_EXPIRA_HORAS=72
# Com '1', o verificador envia sem aprovacao humana (default: aprovacao):
# COBRANCA_AUTO=
# Pedido sem evento novo ha N horas abre pendencia + cobranca (default 24):
# PENDENCIA_HORAS=24
# Intervalo do verificador de pendencias (ms, default 5 min):
# PENDENCIA_TICK_MS=300000
