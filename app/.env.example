# Banco (obrigatorio): Postgres real, sem fallback
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry

# Ancora na Base Sepolia (opcional; sem ela /api/anchor devolve motivo)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=

# IMAP (opcional; sem IMAP_HOST o polling fica desligado)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_MS=30000
# IMAP_DESDE=2026-11-21   # padrao: so mensagens de hoje em diante

# LLM OpenAI-compatible para extracao de PDF (opcional; sem ela PDF vai para revisao)
# Local: LLM_API_URL=http://localhost:11434/v1/chat/completions (Ollama)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Porta da API
PORT=3000
