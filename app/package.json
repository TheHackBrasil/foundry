{
  "name": "foundry-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP da camada de coordenacao (spec 0004): ledger append-only + divergencia + propagacao por parte",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:all": "npm run dev & npm --prefix web run dev",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "test": "vitest run shared server operador && npm --prefix web run test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@dbos-inc/dbos-sdk": "^5.7.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "exceljs": "4.4.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "imapflow": "^2.12.2",
    "mailauth": "^8.1.0",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.0",
    "papaparse": "^5.7.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
